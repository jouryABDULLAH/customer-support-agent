# -----------------------------------------------------------------------------
# Copy to `.env` (gitignored) to configure LangSmith without touching the
# shell. ONLY the LANGSMITH_*/LANGCHAIN_* variables are read from `.env`, at
# entry-point startup, and a variable exported in the shell always wins.
#
# Everything else here is documentation: GROQ_API_KEY and the application
# variables are read from the PROCESS ENVIRONMENT only. PowerShell:
#
#     $env:GROQ_API_KEY = "..."
# -----------------------------------------------------------------------------

# --- Required ----------------------------------------------------------------

# Groq API key. Shell environment only; a value in .env is deliberately
# IGNORED -- see observability._DOTENV_KEYS.
GROQ_API_KEY=

# --- LangSmith tracing (all optional; app runs normally without them) --------

# Turn tracing on. Without LANGSMITH_API_KEY it is forced off with a warning.
LANGSMITH_TRACING=true

# Required for tracing to actually be enabled. Never validated at startup;
# live trace verification is deferred until real credentials exist.
LANGSMITH_API_KEY=

# Optional. Defaults to "customer-support-agent" when tracing is enabled.
LANGSMITH_PROJECT=customer-support-agent

# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Application (all optional, showing defaults) ----------------------------

RAG_TENANT=customer_support_demo
DOCS_DIR=Docs
APP_DB_PATH=data/app.db
# LangGraph thread checkpoints; kept in a separate file from APP_DB_PATH.
CHECKPOINT_DB_PATH=data/checkpoints.db
FIND_TIMEOUT_SECONDS=420
RAG_CONFIDENCE_THRESHOLD=0.55
# DEBUG | INFO | WARNING | ERROR | CRITICAL | OFF
LOG_LEVEL=INFO
# true strips the model's citation markers (e.g. 【1†L1-L3】) from customer
# replies. Off by default: in development they show which passage each claim
# leaned on. Shell-only, like the other application variables.
STRIP_CITATION_MARKERS=false
