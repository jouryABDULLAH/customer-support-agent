# -----------------------------------------------------------------------------
# NOTE: this file is documentation, not configuration that gets loaded.
#
# This application reads the PROCESS ENVIRONMENT only -- it never loads a .env
# file (ragent2's get_settings() would, but this app builds Settings directly).
# Export these in your shell instead. PowerShell:
#
#     $env:LANGSMITH_TRACING = "true"
#     $env:LANGSMITH_API_KEY = "lsv2_..."
# -----------------------------------------------------------------------------

# --- Required ----------------------------------------------------------------

# Groq API key. Shell environment only; deliberately never stored in .env.
GROQ_API_KEY=

# --- LangSmith tracing (all optional; app runs normally without them) --------

# Turn tracing on. Without LANGSMITH_API_KEY it is forced off with a warning.
LANGSMITH_TRACING=true

# Required for tracing to actually be enabled. Never validated at startup;
# live trace verification is deferred until real credentials exist.
LANGSMITH_API_KEY=

# Optional. Defaults to "customer-support-agent" when tracing is enabled.
LANGSMITH_PROJECT=customer-support-agent

# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Application (all optional, showing defaults) ----------------------------

RAG_TENANT=customer_support_demo
DOCS_DIR=Docs
APP_DB_PATH=data/app.db
FIND_TIMEOUT_SECONDS=420
RAG_CONFIDENCE_THRESHOLD=0.55
# DEBUG | INFO | WARNING | ERROR | CRITICAL | OFF
LOG_LEVEL=INFO
